#!/usr/bin/env python3
"""Pick an app, then its Blackwall theme. Each app changes independently."""
import argparse
from datetime import datetime
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
KIT = ROOT / 'themes'
APPS = {'starship': ('󰆍', 'Shell prompt'), 'zed': ('', 'Code editor'), 'ghostty': ('', 'Terminal')}
THEMES = {
    'overdrive': ('David', 'yellow / mint'),
    'moonwire': ('Lucy', 'lavender / cyan'),
    'riot': ('Rebecca', 'mint / pink'),
    'ghost': ('Adam Smasher', 'red / silver'),
}
ALIASES = {'david': 'overdrive', 'lucy': 'moonwire', 'rebecca': 'riot', 'smasher': 'ghost', 'adam': 'ghost'}


def jsonc(text):
    """Mask comments/trailing commas without shifting positions or touching strings."""
    masked = re.sub(r'("(?:\\.|[^"\\])*")|//[^\n]*|/\*[\s\S]*?\*/',
                    lambda m: m[0] if m[1] else re.sub(r'[^\n]', ' ', m[0]), text)
    clean = re.sub(r'("(?:\\.|[^"\\])*")|,(?=\s*[}\]])',
                   lambda m: m[0] if m[1] else ' ', masked)
    value = json.loads(clean)
    if not isinstance(value, dict):
        raise ValueError('Settings must contain a JSON object')
    return value, clean, masked


def set_zed_theme(text, label):
    settings, clean, masked = jsonc(text)
    previous = settings.get('theme')
    theme = dict(previous, mode='dark', dark=label) if isinstance(previous, dict) else label
    if previous == theme:
        return text
    decoder = json.JSONDecoder()
    pos = clean.index('{') + 1
    last_end = pos
    while True:
        pos = re.compile(r'\s*').match(clean, pos).end()
        if clean[pos] == '}':
            break
        key, pos = decoder.raw_decode(clean, pos)
        pos = re.compile(r'\s*:\s*').match(clean, pos).end()
        start = pos
        _, pos = decoder.raw_decode(clean, pos)
        if key == 'theme':
            line_start = text.rfind('\n', 0, start) + 1
            indent = re.match(r'\s*', text[line_start:start])[0]
            replacement = json.dumps(theme, indent=2).replace('\n', '\n' + indent)
            return text[:start] + replacement + text[pos:]
        last_end = pos
        pos = re.compile(r'\s*,?\s*').match(clean, pos).end()
    close = clean.rfind('}')
    comma = ',' if settings and not masked[:close].rstrip().endswith(',') else ''
    prefix = text[:last_end] + comma + text[last_end:close]
    return prefix.rstrip() + '\n  "theme": ' + json.dumps(theme) + '\n' + text[close:]


def read_status(home):
    result = {}
    for app in APPS:
        try:
            if app == 'starship':
                text = (home / '.config/starship.toml').read_text()
                match = re.search(r'^# Blackwall (\w+)', text, re.M)
                result[app] = match[1] if match else 'custom'
            elif app == 'zed':
                settings, _, _ = jsonc((home / '.config/zed/settings.json').read_text())
                theme = settings.get('theme', 'default')
                result[app] = theme.get('dark', 'default') if isinstance(theme, dict) else theme
            else:
                text = (home / '.config/ghostty/config').read_text()
                match = re.search(r'^\s*theme\s*=\s*(.*?)\s*$', text, re.M)
                result[app] = match[1].strip('"') if match else 'default'
        except (OSError, ValueError):
            result[app] = 'not configured'
    return result


def choose(title, rows, colors=None):
    """Use a small keyboard picker; numbered choices work without fzf."""
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise ValueError('Run blackwall in a terminal, or use: blackwall <app> <theme>')
    fzf = shutil.which('fzf')
    if fzf:
        accent = colors['accent'] if colors else '#e8cd62'
        focus = colors['focus'] if colors else '#7bd8ae'
        result = subprocess.run([
            fzf, '--ansi', '--no-multi', '--no-sort', '--cycle', '--layout=reverse',
            '--height=~12', '--border=rounded', '--info=hidden', '--no-scrollbar',
            '--delimiter=\t', '--with-nth=2..', '--prompt=  ❯ ', '--pointer=▸',
            '--border-label= BLACKWALL ', '--header=' + title + '\n↑ ↓ choose · Enter select · Esc cancel',
            '--color=' + f'bg:#000000,bg+:#171a19,fg:#b6c2bd,fg+:#f0f1ec,hl:{focus},hl+:{focus},pointer:{accent},prompt:{accent},border:#3b4741,label:{accent},header:#a9b8b0',
        ], input='\n'.join(key+'\t'+label for key, label in rows), text=True, stdout=subprocess.PIPE,
            env={**os.environ, 'FZF_DEFAULT_OPTS': '', 'FZF_DEFAULT_OPTS_FILE': ''})
        if result.returncode in (1, 130):
            raise KeyboardInterrupt
        if result.returncode:
            raise ValueError('The theme picker could not open')
        return result.stdout.strip().split('\t', 1)[0]
    print('\nBLACKWALL · ' + title + '\n')
    for i, (_, label) in enumerate(rows, 1):
        print(f'  {i}. {label}')
    while True:
        answer = input('\nChoose 1–' + str(len(rows)) + ' (q cancels): ').strip().lower()
        if answer in ('q', ''):
            raise KeyboardInterrupt
        if answer.isdigit() and 1 <= int(answer) <= len(rows):
            return rows[int(answer)-1][0]
        print('Choose a number from the list.')


def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=path.name+'.', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(text)
        if path.exists():
            os.chmod(temporary, path.stat().st_mode & 0o777)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def apply(home, app, theme):
    label = 'Blackwall ' + theme.title()
    writes = {}
    if app == 'starship':
        writes[home / '.config/starship.toml'] = (KIT / f'starship/blackwall-{theme}.toml').read_text()
    elif app == 'zed':
        path = home / '.config/zed/settings.json'
        writes[path] = set_zed_theme(path.read_text() if path.exists() else '{}\n', label)
        writes[home / '.config/zed/themes/blackwall.json'] = (KIT / 'zed/blackwall.json').read_text()
    else:
        path = home / '.config/ghostty/config'
        text = path.read_text() if path.exists() else ''
        setting = 'theme = Blackwall-' + theme.title()
        text = re.sub(r'^[ \t]*theme[ \t]*=.*$', setting, text, flags=re.M) if re.search(r'^[ \t]*theme[ \t]*=', text, re.M) else setting+'\n'+text
        writes[path] = text
        name = 'Blackwall-' + theme.title()
        writes[home / '.config/ghostty/themes' / name] = (KIT / 'ghostty' / name).read_text()
    # Resolve sources and parse settings before making any changes. Back up every
    # changed destination before writing, and roll back if a write fails.
    changed = {p: text for p, text in writes.items() if not p.exists() or p.read_text() != text}
    originals = {p: p.read_text() if p.exists() else None for p in changed}
    stamp = datetime.now().strftime('%Y%m%d-%H%M%S-%f')
    backup = home / '.config/blackwall/backups' / stamp
    for path in changed:
        if path.exists():
            target = backup / path.relative_to(home)
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(path, target)
    try:
        for path, text in changed.items():
            atomic_write(path, text)
    except (OSError, KeyboardInterrupt):
        for path, text in originals.items():
            if text is None:
                path.unlink(missing_ok=True)
            else:
                atomic_write(path, text)
        raise
    print(f'\n  {APPS[app][0]} {app.title()} → {label}' + ('' if changed else ' (already selected)'))
    print('  ' + {'starship': 'Ready at your next prompt.',
                    'zed': 'Zed watches its settings and refreshes automatically.',
                    'ghostty': 'Press Cmd+Shift+, in Ghostty to reload its colors.'}[app])


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog='Examples: blackwall · blackwall zed · blackwall ghostty lucy · blackwall status')
    parser.add_argument('app', nargs='?', choices=[*APPS, 'status'])
    parser.add_argument('theme', nargs='?', help='overdrive, moonwire, riot, ghost (or character name)')
    args = parser.parse_args()
    home = Path.home()
    if args.app == 'status':
        for app, theme in read_status(home).items():
            print(f'  {APPS[app][0]} {app.title():8} {theme}')
        return
    theme = args.theme.lower().removeprefix('blackwall-') if args.theme else None
    theme = ALIASES.get(theme, theme)
    if theme and theme not in THEMES:
        parser.error('Choose overdrive, moonwire, riot or ghost; character names work too.')
    if theme and not args.app:
        parser.error('Choose an app first.')
    statuses = read_status(home)
    app = args.app or choose('01 / Choose an app', [(key, f'{icon}  {key.title():9} {description:14} · {statuses[key]}') for key, (icon, description) in APPS.items()])
    if not theme:
        rows = []
        for key, (character, colors) in THEMES.items():
            palette = json.loads((ROOT / f'themes/blackwall-{key}.json').read_text())['vars']
            r, g, b = (int(palette['accent'][i:i+2], 16) for i in (1, 3, 5))
            current = '  ✓' if key in statuses[app].lower() else ''
            rows.append((key, f'\x1b[38;2;{r};{g};{b}m◆\x1b[0m  {key.title():10} {character:13} {colors}{current}'))
        theme = choose('02 / ' + app.title() + ' · Choose a theme', rows)
    apply(home, app, theme)


if __name__ == '__main__':
    try:
        main()
    except (KeyboardInterrupt, EOFError):
        print('\n  Cancelled. No theme changed.')
        sys.exit(0)
    except (OSError, ValueError) as error:
        print('blackwall: ' + str(error), file=sys.stderr)
        sys.exit(1)
